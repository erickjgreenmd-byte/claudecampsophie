# Cloudflare Pages headers for the PencilLift parent portal (WEB-02; docs/Deployment_Runbook.md §3.5).
# Vite copies this file from public/ into dist/ unchanged; src/headers.test.ts asserts every value.
#
# The API and Supabase origins are build variables, so a static file cannot list them: connect-src
# allows 'self' and https: only. Scripts come only from this origin (Vite emits no inline script;
# the test checks index.html). React sets style attributes, which is why style-src alone carries
# 'unsafe-inline'. Referrer-Policy matches the no-referrer meta in index.html.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https:; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted bundles only; the HTML shell keeps the host's revalidating default.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
