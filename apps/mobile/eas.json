{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.pencillift.com",
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.pencillift.com",
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.pencillift.com",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "preview-amazon": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api-staging.pencillift.com",
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_ANDROID_STORE": "amazon"
      }
    },
    "production-amazon": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.pencillift.com",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ANDROID_STORE": "amazon"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
