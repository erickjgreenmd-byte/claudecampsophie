#!/usr/bin/env bash
# Versioned pre-commit gate (BUG-024/BUG-034, lessons L-004/L-008): a commit cannot go through when a
# staged file fails lint or formatting, when the staged tree does not typecheck, or when the secret
# scan fails. Enabled with:
#   git config core.hooksPath scripts/git-hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
lintable=()
formattable=()
for f in "${staged[@]}"; do
  case "$f" in
    *.ts | *.tsx | *.js | *.mjs) lintable+=("$f"); formattable+=("$f") ;;
    *.json | *.css | *.yml | *.yaml) formattable+=("$f") ;;
  esac
done
if [ "${#formattable[@]}" -gt 0 ]; then npx prettier --check "${formattable[@]}"; fi
if [ "${#lintable[@]}" -gt 0 ]; then npx eslint --max-warnings=0 --no-warn-ignored "${lintable[@]}"; fi
# Typecheck the staged tree itself, not the working tree (BUG-034): catches commits that import
# untracked files or depend on unstaged edits while other work is in progress.
if [ "${#lintable[@]}" -gt 0 ]; then scripts/check-staged-tree.sh; fi
node scripts/scan-secrets.mjs --staged
